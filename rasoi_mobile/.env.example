# Rasoi mobile environment files
#
#   .env                    — shared secrets only (gitignored). Copy from this file.
#   .env.development        — dev API URL; loaded by `npm start` / `expo start`
#   .env.production         — prod API URL; loaded by release APK / EAS production builds
#   .env.development.local  — optional per-machine LAN IP (gitignored; see .env.development.local.example)
#
# Rasoi API — see .env.development (dev) and .env.production (release builds).
# Shared secrets (Supabase, Sentry, RevenueCat, …) belong in this file only.
# Do not set EXPO_PUBLIC_API_URL here unless you want a fallback; dev/prod files override it.
# EXPO_PUBLIC_API_URL=https://rasoiapplication.in

# Supabase (Dashboard → Project Settings → API)
# Enable Email provider + OTP in Authentication → Providers → Email
# Enable Anonymous sign-ins for "Explore as Guest" (links guest → register in Supabase):
#   Authentication → Providers → Anonymous sign-ins → Enable
# Custom SMTP (Supabase Dashboard → Authentication → SMTP Settings)
# OTP sign-in codes are sent by Supabase Auth — NOT from this app or the backend.
# Sender must be cooking@rasoiapplication.in (public support address).
#
# Recommended (domain uses Cloudflare Email Routing → Gmail inbox):
#   1. Gmail → Settings → Accounts → "Send mail as" → add cooking@rasoiapplication.in
#   2. Verify via the forwarded confirmation email
#   3. Supabase SMTP:
#        Host: smtp.gmail.com | Port: 587 | TLS 1.2
#        Username: your Gmail that receives cooking@ forwards
#        Password: Google App Password (not login password)
#        Sender email: cooking@rasoiapplication.in
#        Sender name: Rasoi App
#
# Do NOT use my.website.email2@gmail.com as the visible sender — that is the AdMob/dev Gmail only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required once per Supabase project: expose the rasoi schema (Dashboard → Settings → API → Exposed schemas).
# Migration: supabase/migrations/20250621160000_expose_rasoi_schema_api.sql
# Phase 1–3: direct Supabase reads/writes + Edge Function auth (set to 0 to force API/JWT path)
# EXPO_PUBLIC_DIRECT_SUPABASE_READS=0
# Egress: route public catalog (recipes, reference, sponsors) through rasoiapplication.in instead of Supabase PostgREST
# EXPO_PUBLIC_DIRECT_SUPABASE_CATALOG=0
# Log every Supabase HTTP request/response in Metro console (__DEV__ enables this by default)
# EXPO_PUBLIC_SUPABASE_DEBUG=1
#
# Phase 3 Edge Functions (deploy once from rasoi_mobile/):
#   supabase link --project-ref <ref>
#   supabase functions deploy rasoi-auth-sync --no-verify-jwt --use-api
#   supabase functions deploy rasoi-auth-guest --no-verify-jwt --use-api

# App Store screenshots only
# EXPO_PUBLIC_SCREENSHOT_MODE=1
# EXPO_PUBLIC_QA_MONETIZATION=1  # Show paywall/trial QA buttons on Home (release QA builds; also on in __DEV__)

# Payments — controlled from admin /admin/payments (paymentsEnabled in /api/reference).
# When admin enables payments, set provider to revenuecat for Play/App Store billing:
EXPO_PUBLIC_PAYMENT_PROVIDER=revenuecat
# Test Store (dev / sandbox before Play products are active):
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_SJxxLWvHNMyNuMgqvvFMAhddtiC
# Production store keys (RevenueCat → Project → Apps → API keys):
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_HHYkVegKPcskYJYCtbxGuPGMahj
# EXPO_PUBLIC_PAYMENT_PROVIDER=stub
# EXPO_PUBLIC_PAYMENT_PROVIDER=razorpay
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Sentry — error monitoring + session replay (https://sentry.io)
# Project: rasoi-app / rasoi-mobile
# Environments sent by the app: Development (Expo dev) | Production (release APK/AAB)
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional override — normally auto: Development in __DEV__, Production in release builds
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=Development
# EXPO_PUBLIC_SENTRY_DEBUG=1
# Set to 1 to skip Sentry while running Expo dev (events only from release builds)
# EXPO_PUBLIC_SENTRY_DISABLE_IN_DEV=1

# Push notifications (Expo + FCM) — required for release APK token registration
# Run: npm run setup:push  (or eas init + add google-services.json from Firebase)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid

# Firebase Analytics + Crashlytics (native modules — release APK only, not Expo Go)
# Enabled by default in production builds. Set to 1 to test on device in dev.
# EXPO_PUBLIC_FIREBASE_ANALYTICS_ENABLED=1
# EXPO_PUBLIC_FIREBASE_CRASHLYTICS_ENABLED=1

# Firebase Phone Auth — signup SMS verification (requires native rebuild + Phone provider in Firebase Console)
# Set to 1 to skip SMS and use email OTP only (Maestro QA / local dev without Firebase test numbers)
# EXPO_PUBLIC_SKIP_PHONE_VERIFY=1

# Optional — App Store listing id for iOS rating fallback (when app is on App Store)
# EXPO_PUBLIC_IOS_APP_STORE_ID=1234567890
