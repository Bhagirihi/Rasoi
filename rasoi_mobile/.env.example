# Rasoi API
# Development (local backend on your LAN):
EXPO_PUBLIC_API_URL=http://192.168.1.27:3000
# Production builds default to https://rasoiapplication.in when unset.

# Supabase (Dashboard → Project Settings → API)
# Enable Email provider + OTP in Authentication → Providers → Email
# Custom SMTP: Gmail (Authentication → Emails → SMTP Settings)
#   Host: smtp.gmail.com | Port: 587
#   User: your Gmail address | Password: Google App Password (not your login password)
#   Sender: same Gmail address | Sender name: Rasoi App
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# App Store screenshots only
# EXPO_PUBLIC_SCREENSHOT_MODE=1

# Payments — controlled from admin /admin/payments (paymentsEnabled in /api/reference).
# Provider below is used only when admin enables payments in the console.
EXPO_PUBLIC_PAYMENT_PROVIDER=stub
# EXPO_PUBLIC_PAYMENT_PROVIDER=revenuecat
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# EXPO_PUBLIC_PAYMENT_PROVIDER=razorpay
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Sentry — error monitoring (https://sentry.io)
# Create projects: rasoi-mobile (React Native) and rasoi-api (Next.js)
# Required in release .env before building APK/AAB.
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# EXPO_PUBLIC_SENTRY_DEBUG=1

# Push notifications (Expo + FCM) — required for release APK token registration
# Run: npm run setup:push  (or eas init + add google-services.json from Firebase)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid

# Optional — App Store listing id for iOS rating fallback (when app is on App Store)
# EXPO_PUBLIC_IOS_APP_STORE_ID=1234567890
