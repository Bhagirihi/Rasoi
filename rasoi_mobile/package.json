{
  "name": "rasoi",
  "main": "expo-router/entry",
  "version": "1.0.5",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^24.1.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/crashlytics": "^24.1.1",
    "@sentry/react-native": "^8.14.0",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-purchases": "^10.4.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleDebug && mkdir -p ../dist && cp app/build/outputs/apk/debug/app-debug.apk ../dist/rasoi-debug.apk",
    "android:release-apk": "bash scripts/build-release-apk.sh",
    "setup:push": "bash scripts/setup-push.sh",
    "setup:firebase": "bash scripts/setup-firebase.sh",
    "setup:firebase-linking": "bash scripts/firebase-linking-checklist.sh",
    "setup:fcm": "node scripts/generate-fcm-service-account.mjs && node scripts/upload-eas-fcm.cjs",
    "eas-build-post-install": "bash scripts/eas-inject-google-services.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "store-premium": "cd screenshots && npm run generate",
    "store-preview": "cd screenshots && npm run dev",
    "qa:preflight": "bash scripts/qa-preflight.sh",
    "qa:smoke": "bash scripts/run-device-qa.sh smoke",
    "qa:auth": "bash scripts/run-device-qa.sh auth",
    "qa:modules": "bash scripts/run-device-qa.sh modules",
    "qa:device": "bash scripts/run-device-qa.sh all",
    "qa:full": "bash scripts/run-full-device-qa.sh",
    "qa:stability": "python3 scripts/run-stability-3x.py",
    "qa:guest-delete": "python3 scripts/run-guest-delete-qa.py",
    "qa:new": "python3 scripts/run-new-qa.py"
  },
  "private": true
}
