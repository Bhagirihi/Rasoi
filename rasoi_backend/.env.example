# Public site URL (SEO canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://rasoiapplication.in"

# Google Play open testing + listing (defaults match com.bhagihiri.rasoiapp)
# NEXT_PUBLIC_PLAY_STORE_TESTING_URL="https://play.google.com/apps/testing/com.bhagihiri.rasoiapp"
# NEXT_PUBLIC_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.bhagihiri.rasoiapp"

# Optional: EAS artifact URL for /api/download/apk redirect (run get-eas-apk-url.sh after each EAS build)
# NOT the Expo project page — https://expo.dev/accounts/takeyshi/projects/rasoi requires login
# ANDROID_APK_EXPO_URL="https://expo.dev/artifacts/eas/....apk"

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Database password only (NOT the full connection string)
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_PASSWORD="your-database-password"
# Optional: copy pooler hostname from Connect if you get "tenant/user not found"
# SUPABASE_POOLER_HOST="aws-0-ap-south-1.pooler.supabase.com"

# Or set full URIs manually (password must be URL-encoded if it contains @ # etc.)
# Runtime: Supabase pooled connection (Transaction pooler, port 6543)
# Dashboard → Project Settings → Database → Connection string → URI → "Transaction pooler"
# Append ?pgbouncer=true if not already present.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate, db push, seed): direct connection (port 5432)
# Dashboard → Connection string → URI → "Direct connection"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth — change in production (required on Vercel prod; app fails to start if missing/default)
JWT_SECRET="replace-with-a-long-random-secret"

# Dev-only stub billing (never set to 1 in production)
# ALLOW_STUB_BILLING=0

# Vercel Cron + GitHub Actions keep-alive (random string; Vercel sends as Bearer token)
CRON_SECRET="replace-with-a-long-random-secret"

# Supabase service role (Dashboard → Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# RevenueCat — server verification + webhooks (Dashboard → Project → API keys → Secret)
REVENUECAT_PROJECT_ID="proj1100e927"
REVENUECAT_SECRET_API_KEY="sk_..."
# Webhook auth (Integrations → Webhooks → Authorization header Bearer token)
REVENUECAT_WEBHOOK_SECRET="replace-with-a-long-random-secret"
# Webhook URL: https://rasoiapplication.in/api/billing/revenuecat/webhook

# Seed script only (optional overrides)
ADMIN_EMAIL="admin@rasoi.app"
ADMIN_PASSWORD="rasoi-admin123"
