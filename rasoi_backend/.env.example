# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Database password only (NOT the full connection string)
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_PASSWORD="your-database-password"
# Optional: copy pooler hostname from Connect if you get "tenant/user not found"
# SUPABASE_POOLER_HOST="aws-0-ap-south-1.pooler.supabase.com"

# Or set full URIs manually (password must be URL-encoded if it contains @ # etc.)
# Runtime: Supabase pooled connection (Transaction pooler, port 6543)
# Dashboard → Project Settings → Database → Connection string → URI → "Transaction pooler"
# Append ?pgbouncer=true if not already present.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate, db push, seed): direct connection (port 5432)
# Dashboard → Connection string → URI → "Direct connection"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth — change in production
JWT_SECRET="replace-with-a-long-random-secret"

# Vercel Cron + GitHub Actions keep-alive (random string; Vercel sends as Bearer token)
CRON_SECRET="replace-with-a-long-random-secret"

# Supabase service role (Dashboard → Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Seed script only (optional overrides)
ADMIN_EMAIL="admin@rasoi.app"
ADMIN_PASSWORD="rasoi-admin123"

# Sentry — error monitoring (https://sentry.io)
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ORG="rasoi"
SENTRY_PROJECT="rasoi-api"
# SENTRY_AUTH_TOKEN="..."  # CI / source map upload only
