# Rasoi App — local env (never commit). Also set these as EAS production secrets.

# Billing: stub | revenuecat | razorpay
# Leave unset to auto-select revenuecat when RC keys below are present.
EXPO_PUBLIC_PAYMENT_PROVIDER=

# RevenueCat public SDK keys (Project → Apps → API keys)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Optional Razorpay (if EXPO_PUBLIC_PAYMENT_PROVIDER=razorpay)
EXPO_PUBLIC_RAZORPAY_KEY_ID=
