# Copy to .env and fill in after Meta Developer setup (see README in this folder).
#
# 1. Create app at https://developers.facebook.com
# 2. Add "Instagram API with Instagram business login"
# 3. Generate token → INSTAGRAM_ACCESS_TOKEN (starts with IGAA…)
# 4. GET https://graph.instagram.com/v25.0/me?fields=user_id,username&access_token=YOUR_TOKEN
#    → user_id is INSTAGRAM_USER_ID (or use "me")

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=me

# Optional — token refresh / webhooks
# META_APP_ID=
# META_APP_SECRET=
