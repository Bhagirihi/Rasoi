# Google Search Console MCP — https://search.google.com/search-console
#
# Auth: Application Default Credentials (recommended)
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/webmasters.readonly
#
# Enable API on your GCP project:
#   gcloud services enable searchconsole.googleapis.com
#
# Optional: default property for tools (URL-prefix or sc-domain:)
GSC_DEFAULT_SITE_URL=https://rasoiapplication.in/

# Optional: compact tool output (toon)
# GSC_OUTPUT_FORMAT=toon
