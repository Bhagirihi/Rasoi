# Google account that owns the Play Console developer account
GOOGLE_ACCOUNT_EMAIL=my.website.email2@gmail.com

# Developer account display name (set during Play Console signup)
PLAY_DEVELOPER_NAME=Bhagihiri Applications

# Play Console app display name
PLAY_APP_TITLE=Rasoi APP

# Rasoi Android package (must already exist in Play Console)
RASOI_PACKAGE_NAME=com.bhagihiri.rasoiapp

# Regions version from https://play.google.com/supported-locations/ (dropdown, e.g. 2025/01)
PLAY_REGIONS_VERSION=2025/01

# Auth mode: service_account (recommended) or oauth
PLAY_AUTH_MODE=service_account

# Service account JSON filename inside credentials/ (create in Play Console → Users & permissions)
SERVICE_ACCOUNT_FILE=service_account.json
